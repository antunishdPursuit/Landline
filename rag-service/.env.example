# Anthropic — server-only, never expose to any client
ANTHROPIC_API_KEY=

# Supabase Postgres — server-only, used via psycopg2/pgvector
# Get this from Supabase Project Settings > Database > Connection string
SUPABASE_DB_URL=

# Shared secret this service requires on every request, via the
# X-Internal-Api-Key header. Generate a random value; whoever wires this
# service into the ElevenLabs/classifier flow needs the same value.
RAG_SERVICE_API_KEY=

# Optional — model overrides, sensible defaults are used if unset
RAG_REWRITE_MODEL=claude-haiku-4-5-20251001
RAG_GENERATION_MODEL=claude-sonnet-5
RAG_CONTEXT_SUMMARY_MODEL=claude-haiku-4-5-20251001
