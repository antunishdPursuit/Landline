# ElevenLabs — server-only, never NEXT_PUBLIC_
ELEVENLABS_API_KEY=
ELEVENLABS_AGENT_ID=

# Paid routes remain paused until explicitly enabled with shared quotas.
# These limits count admitted requests, not provider dollars or conversation duration.
LANDLINE_PAID_SERVICES_ENABLED=false
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
LANDLINE_GLOBAL_DAILY_REQUESTS=20
LANDLINE_USER_DAILY_REQUESTS=5
LANDLINE_USER_MINUTE_REQUESTS=2

# Clerk — server-only
CLERK_SECRET_KEY=

# Clerk — client-safe
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
NEXT_PUBLIC_CLERK_SIGN_IN_URL=/sign-in
NEXT_PUBLIC_CLERK_AFTER_SIGN_IN_URL=/dashboard

# Public demo credentials displayed on the sign-in page. Use a demo-only password.
NEXT_PUBLIC_DEMO_USERNAME=
NEXT_PUBLIC_DEMO_PASSWORD=

# Current-information concierge search — server-only
TAVILY_API_KEY=

# Stay22 Direct Travel API — public no-key demo endpoint, server-only configuration
STAY22_API_BASE_URL=https://api.stay22.com/v2/accommodations
